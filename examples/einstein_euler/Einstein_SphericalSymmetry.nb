Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SeriesSubs", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"m", "'"}], "[", "r", "]"}], "->", 
     RowBox[{
      SubscriptBox["a", "1"], "+", 
      RowBox[{"2", "*", 
       SubscriptBox["a", "2"], "*", "r"}], "+", 
      RowBox[{"3", 
       SubscriptBox["a", "3"], "*", 
       SuperscriptBox["r", "2"]}], "+", 
      RowBox[{"4", "*", 
       SubscriptBox["a", "4"], "*", 
       SuperscriptBox["r", "3"]}], "+", 
      RowBox[{"5", "*", 
