      RowBox[{"11", "*", 
       SubscriptBox["b", "11"], "*", 
       SuperscriptBox["r", "10"]}], "+", 
      SuperscriptBox[
       RowBox[{"O", "[", "r", "]"}], "11"]}]}], ",", 
    RowBox[{
     RowBox[{"m", "[", "r", "]"}], "->", 
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "*", "r"}], "+", 
      RowBox[{
       SubscriptBox["a", "2"], "*", 
