       SuperscriptBox["r", "10"]}], "+", 
      SuperscriptBox[
       RowBox[{"O", "[", "r", "]"}], "11"]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "'"}], "[", "r", "]"}], "->", 
     RowBox[{
      SubscriptBox["b", "1"], "+", 
      RowBox[{"2", "*", 
       SubscriptBox["b", "2"], "*", "r"}], "+", 
      RowBox[{"3", 
       SubscriptBox["b", "3"], "*", 
       SuperscriptBox["r", "2"]}], "+", 
      RowBox[{"4", "*", 
       SubscriptBox["b", "4"], "*", 
